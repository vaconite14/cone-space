{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cone-space",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); Set-Location claude-office; node server/index.js"
      ],
      "port": 3334,
      "autoPort": false
    }
  ]
}
